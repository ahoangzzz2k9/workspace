# Cấu hình môi trường — sao chép thành .env rồi sửa.
# Server tự đọc .env khi khởi động (không cần dotenv).

# Địa chỉ lắng nghe. 127.0.0.1 = chỉ máy này; 0.0.0.0 = cho container/reverse proxy.
HOST=127.0.0.1

# Cổng HTTP. Nếu bận, app tự thử cổng kế tiếp (trừ khi chạy trong container).
PORT=4321

# Đường dẫn SQLite. Trên server nên trỏ ra ngoài thư mục code để dễ backup.
CUNGLAM_DB=./data/cunglam.db

# 1 = tạo dữ liệu demo lần đầu; 0 = database trống cho môi trường thật.
CUNGLAM_SEED=1

# Cookie Secure: auto | true | false. Đặt true khi chạy sau HTTPS.
COOKIE_SECURE=auto

# 1 = tin header X-Forwarded-Proto từ reverse proxy (Caddy/Nginx).
TRUST_PROXY=0
